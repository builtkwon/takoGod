{
  "name": "takoyaki-truck",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "tool": "tsx harness/scripts/tool.ts",
    "prepare": "p=$(git rev-parse --show-prefix 2>/dev/null) && [ -z \"$p\" ] && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "dependency-cruiser": "^18.8.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
